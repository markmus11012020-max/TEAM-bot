# ------------------------------------------------------------------ Telegram
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# admins — управлять записью могут только ADMIN_USER_IDS, everyone — все участники
COMMAND_ACCESS=admins
# ID пользователей через запятую (узнать: @userinfobot)
ADMIN_USER_IDS=
# Необязательно: ограничить бота конкретными чатами (ID через запятую)
ALLOWED_CHAT_IDS=
# Не индексировать сообщения других ботов
IGNORE_BOTS=true
# Не отвечать на вопросы старше N секунд и чаще, чем раз в N секунд на человека
MAX_ANSWER_AGE_SECONDS=120
ANSWER_COOLDOWN_SECONDS=5

# ----------------------------------------------------------------------- LLM
# Единый OpenAI-совместимый шлюз (AITUNNEL по умолчанию)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.aitunnel.ru/v1
CHAT_MODEL=deepseek-v4.1-flash-1017
LLM_MAX_TOKENS=2000
# max_tokens | max_completion_tokens | none
LLM_MAX_TOKENS_PARAM=max_tokens
# Пусто — не передавать temperature (некоторые reasoning-модели её не принимают)
LLM_TEMPERATURE=
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
# Структурированные итоги (JSON Schema); при ошибке автоматически plain-text
STRUCTURED_SUMMARY=true

# ----------------------------------------------------------------- Embeddings
# По умолчанию используются OPENAI_API_KEY / OPENAI_BASE_URL
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# true — передавать dimensions в запрос эмбеддингов (не все провайдеры поддерживают)
EMBEDDING_SEND_DIMENSIONS=false

# ------------------------------------------------------------------- Pinecone
PINECONE_API_KEY=
PINECONE_INDEX=team-bot
PINECONE_NAMESPACE=team-chat
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ------------------------------------------------------------------ Retrieval
RETRIEVAL_TOP_K=12
RECENT_MESSAGES=25
# chat — искать только в текущем чате, all — во всех чатах бота
SEARCH_SCOPE=chat
MESSAGE_CHUNK_CHARS=1800
SUMMARY_CHUNK_CHARS=24000
SUMMARY_MAX_CHARS=120000
SUMMARY_MESSAGE_MAX_CHARS=2000

# -------------------------------------------------------------------- Indexer
INDEX_BATCH_SIZE=12
INDEX_POLL_SECONDS=2
INDEX_MAX_ATTEMPTS=5

# -------------------------------------------------------------------- Sessions
# 0 — не закрывать запись автоматически
SESSION_IDLE_TIMEOUT_MINUTES=0

# ----------------------------------------------------------------------- Infra
DB_PATH=data/team_bot.sqlite3
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
